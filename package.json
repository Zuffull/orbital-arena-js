{
  "name": "orbital-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "node --env-file-if-exists=.env server/index.ts",
    "build": "npm run build -w client",
    "start": "npm run dev:server",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bots": "node scripts/bots.mjs",
    "load": "node scripts/load.mjs",
    "profile": "node scripts/profile.mjs"
  },
  "devDependencies": {
    "ws": "8.18.3",
    "@biomejs/biome": "2.2.5",
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/ws": "8.18.0",
    "vitest": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "@playwright/test": "1.56.1",
    "fast-check": "4.3.0"
  }
}
