{
  "name": "orbital-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "build": "npm run build -w client",
    "start": "npm run dev:server",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.5"
  }
}
