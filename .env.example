PORT=3000
LOG_DIR=logs
DEMO_SLOW=0

# Comma-separated exact origins. Render injects RENDER_EXTERNAL_URL.
# PUBLIC_ORIGINS=https://your-game.onrender.com
# Only set TRUST_PROXY=1 if the service is accessible exclusively through its trusted proxy.
TRUST_PROXY=0
MAX_IP_CONNECTIONS=192
MAX_ROOMS=16
MAX_PLAYERS=8
